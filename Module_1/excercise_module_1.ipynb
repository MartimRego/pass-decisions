    "# Step 2: Extract and visualize both frames\n",
    "def plot_defensive_frame_with_lines(match_id, frame_no, title, frame_info):\n",
    "    \"\"\"Plot a defensive frame with defensive lines highlighted\"\"\"\n",
    "    # Get the frame data\n",
    "    frame_df = df_filtered[\n",
    "        (df_filtered[\"match_id\"] == match_id) & \n",
    "        (df_filtered[\"frame\"] == frame_no)\n",
    "    ].copy()\n",
    "    \n",
    "    # Normalize coordinates\n",
    "    frame_df = normalize_own_goal_left(frame_df, TARGET_TEAM)\n",
    "    \n",
    "    # Assign defensive lines\n",
    "    rm_players = frame_df[\n",
    "        (frame_df[\"player_team_shortname\"] == TARGET_TEAM) & \n",
    "        (~frame_df[\"is_ball\"])\n",
    "    ].copy()\n",
    "    \n",
    "    if len(rm_players) > 0:\n",
    "        labels = kmeans_lines.predict(rm_players[[\"x_norm\"]].values)\n",
    "        centers = kmeans_lines.cluster_centers_.ravel()\n",
    "        line_ids = np.argsort(np.argsort(centers))[labels]\n",
    "        rm_players[\"def_line_id\"] = line_ids\n",
    "    \n",
    "    # Create pitch\n",
    "    pitch = Pitch(pitch_type='statsbomb', pitch_color='#22312b', line_color='#c7d5cc')\n",
    "    fig, ax = pitch.draw(figsize=(12, 8))\n",
    "    \n",
    "    # Plot all players\n",
    "    for team in frame_df[\"player_team_shortname\"].dropna().unique():\n",
    "        team_data = frame_df[\n",
    "            (frame_df[\"player_team_shortname\"] == team) & \n",
    "            (~frame_df[\"is_ball\"])\n",
    "        ]\n",
    "        if team == TARGET_TEAM:\n",
    "            color = '#d20614'  # Red for Real Madrid\n",
    "        else:\n",
    "            color = '#3f88c5'  # Blue for opponent\n",
    "        \n",
    "        pitch.scatter(\n",
    "            team_data[\"x_norm\"], team_data[\"y_norm\"],\n",
    "            s=300, c=color, edgecolors='white', linewidth=2,\n",
    "            ax=ax, label=team, zorder=3\n",
    "        )\n",
    "    \n",
    "    # Plot ball\n",
    "    ball = frame_df[frame_df[\"is_ball\"]]\n",
    "    if len(ball) > 0:\n",
    "        pitch.scatter(\n",
    "            ball[\"x_norm\"], ball[\"y_norm\"],\n",
    "            s=200, c='white', edgecolors='black', linewidth=2,\n",
    "            ax=ax, label='Ball', zorder=4, marker='o'\n",
    "        )\n",
    "    \n",
    "    # Draw defensive lines\n",
    "    if len(rm_players) > 0:\n",
    "        for line_id in [0, 1, 2]:\n",
    "            line_players = rm_players[rm_players[\"def_line_id\"] == line_id]\n",
    "            if len(line_players) > 0:\n",
    "                x_mean = line_players[\"x_norm\"].mean()\n",
    "                linestyle = '--' if line_id in [0, 1, 2] else '-'\n",
    "                ax.plot(\n",
    "                    [x_mean, x_mean], [0, PITCH_WIDTH],\n",
    "                    color='white', linestyle=linestyle, linewidth=2.5, \n",
    "                    alpha=0.6, zorder=2\n",
    "                )\n",
    "    \n",
    "    # Add info text\n",
    "    info_text = f\"Back→High: {frame_info['total_depth']:.1f}m\\n\"\n",
    "    info_text += f\"Back: {frame_info['back_line']:.1f}m | Mid: {frame_info['midfield_line']:.1f}m | High: {frame_info['high_line']:.1f}m\"\n",
    "    ax.text(52.5, -3, info_text, ha='center', va='top', fontsize=10, \n",
    "            color='white', bbox=dict(boxstyle='round', facecolor='black', alpha=0.7))\n",
    "    \n",
    "    ax.set_title(title, fontsize=14, color='white', pad=20)\n",
    "    ax.legend(loc='upper left', fontsize=10)\n",
    "    \n",
    "    return fig, ax\n",
    "\n",
    "# Plot both frames side by side\n",
    "fig, axes = plt.subplots(1, 2, figsize=(20, 8))\n",
    "\n",
    "# Most compact frame\n",
    "plt.sca(axes[0])\n",
    "plot_defensive_frame_with_lines(\n",
    "    int(most_compact['match_id']), \n",
    "    int(most_compact['frame']),\n",
    "    f\"🔵 Most COMPACT Frame (Match {int(most_compact['match_id'])})\",\n",
    "    most_compact\n",
    ")\n",
    "\n",
    "# Most stretched frame  \n",
    "plt.sca(axes[1])\n",
    "plot_defensive_frame_with_lines(\n",
    "    int(most_stretched['match_id']), \n",
    "    int(most_stretched['frame']),\n",
    "    f\"🔴 Most STRETCHED Frame (Match {int(most_stretched['match_id'])})\",\n",
    "    most_stretched\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
