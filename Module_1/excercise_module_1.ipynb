    "# Split data by period (1st half = period 1, 2nd half = period 2)\n",
    "rm_def_rows_labeled[\"period\"] = rm_def_rows_labeled.groupby([\"match_id\", \"frame\"])[\"period\"].transform(\"first\")\n",
    "\n",
    "# Filter to only include regular time (periods 1 and 2) - exclude extra time\n",
    "rm_def_rows_regular = rm_def_rows_labeled[rm_def_rows_labeled[\"period\"].isin([1, 2])].copy()\n",
    "\n",
    "print(f\"✅ Filtered to regular time only (periods 1 & 2)\")\n",
    "print(f\"Total frames: {len(rm_def_rows_labeled):,} → Regular time: {len(rm_def_rows_regular):,}\")\n",
    "\n",
    "# Compute line depths by match, period, and defensive line\n",
    "line_stats_by_period = (\n",
    "    rm_def_rows_regular\n",
    "    .groupby([\"match_id\", \"period\", \"def_line_id\"], as_index=False)\n",
    "    .agg({\"x_rescaled\": \"mean\"})\n",
    "    .rename(columns={\"x_rescaled\": \"line_depth\"})\n",
    ")\n",
    "\n",
    "# Add opponent information\n",
    "opponent_map = line_stats_pivot[[\"match_id\", \"opponent\"]].drop_duplicates()\n",
    "line_stats_by_period = line_stats_by_period.merge(opponent_map, on=\"match_id\", how=\"left\")\n",
    "\n",
    "# Pivot to wide format for easier analysis\n",
    "line_stats_by_period_pivot = line_stats_by_period.pivot_table(\n",
    "    index=[\"match_id\", \"opponent\", \"period\"],\n",
    "    columns=\"def_line_id\",\n",
    "    values=\"line_depth\"\n",
    ").reset_index()\n",
    "\n",
    "# Rename columns for clarity\n",
    "line_stats_by_period_pivot.columns.name = None\n",
    "line_stats_by_period_pivot.columns = [\n",
    "    \"match_id\", \"opponent\", \"period\", \"back_line_depth\", \"midfield_line_depth\", \"high_line_depth\"\n",
    "]\n",
    "\n",
    "# Add compactness metrics\n",
    "line_stats_by_period_pivot[\"back_to_midfield\"] = (\n",
    "    line_stats_by_period_pivot[\"midfield_line_depth\"] - line_stats_by_period_pivot[\"back_line_depth\"]\n",
    ")\n",
    "line_stats_by_period_pivot[\"back_to_high\"] = (\n",
    "    line_stats_by_period_pivot[\"high_line_depth\"] - line_stats_by_period_pivot[\"back_line_depth\"]\n",
    ")\n",
    "line_stats_by_period_pivot[\"midfield_to_high\"] = (\n",
    "    line_stats_by_period_pivot[\"high_line_depth\"] - line_stats_by_period_pivot[\"midfield_line_depth\"]\n",
    ")\n",
    "\n",
    "print(f\"✅ Computed compactness for {len(line_stats_by_period_pivot)} match-period combinations\")\n",
    "print(f\"\\nFirst few rows:\")\n",
    "print(line_stats_by_period_pivot.head(10))"
