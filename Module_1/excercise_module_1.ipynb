   "source": [
    "# Step 1: Compute compactness for each individual frame\n",
    "# Add compactness metric to each frame in rm_def_rows_labeled\n",
    "frame_compactness = (\n",
    "    rm_def_rows_labeled\n",
    "    .groupby([\"match_id\", \"frame\", \"def_line_id\"])\n",
    "    .agg({\"x_rescaled\": \"mean\"})\n",
    "    .reset_index()\n",
    "    .pivot(index=[\"match_id\", \"frame\"], columns=\"def_line_id\", values=\"x_rescaled\")\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# Rename columns for clarity\n",
    "frame_compactness.columns = [\"match_id\", \"frame\", \"back_line\", \"midfield_line\", \"high_line\"]\n",
    "\n",
    "# Calculate total compactness (back to high line distance)\n",
    "frame_compactness[\"total_depth\"] = frame_compactness[\"high_line\"] - frame_compactness[\"back_line\"]\n",
    "\n",
    "# Find most compact and most stretched frames\n",
    "most_compact = frame_compactness.nsmallest(1, \"total_depth\").iloc[0]\n",
    "most_stretched = frame_compactness.nlargest(1, \"total_depth\").iloc[0]\n",
    "\n",
    "print(\"🔵 Most COMPACT frame:\")\n",
    "print(f\"  Match ID: {int(most_compact['match_id'])}, Frame: {int(most_compact['frame'])}\")\n",
    "print(f\"  Total depth (back to high): {most_compact['total_depth']:.2f}m\")\n",
    "print(f\"  Back line: {most_compact['back_line']:.2f}m, Mid: {most_compact['midfield_line']:.2f}m, High: {most_compact['high_line']:.2f}m\")\n",
    "\n",
    "print(\"\\n🔴 Most STRETCHED frame:\")\n",
    "print(f\"  Match ID: {int(most_stretched['match_id'])}, Frame: {int(most_stretched['frame'])}\")\n",
    "print(f\"  Total depth (back to high): {most_stretched['total_depth']:.2f}m\")\n",
    "print(f\"  Back line: {most_stretched['back_line']:.2f}m, Mid: {most_stretched['midfield_line']:.2f}m, High: {most_stretched['high_line']:.2f}m\")"
   ]
